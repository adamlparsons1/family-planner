# Postgres connection.
#   Local dev  : leave unset (or set to "pglite") to use the embedded PGlite database in ./.pglite
#   Production : the Neon connection string. Vercel's Neon integration adds its own variable,
#                which the app finds without you copying it here.
DATABASE_URL=

# Your setup word, 8+ characters. /setup asks for it before creating the planner.
SETUP_CODE=

# Optional. 32+ random characters used to sign the sign-in cookie. If unset, /setup
# generates one and keeps it in the database.
SESSION_SECRET=

# Only for `npm run db:seed`, which loads a made-up example family for local development.
SEED_HOUSEHOLD_PASSCODE=
SEED_PARENT_PIN=
